---
import BaseLayout from '../layouts/BaseLayout.astro';
import registry from '../data/registry.json';
import home from '../data/sample-published.json';
import { typo3HostFromContentApiUrl } from '../lib/typo3Storage.mjs';

// Runtime builder configuration, rendered into the page below. When the
// TYPO3_CONTENT_API_URL env var is set (it points at ".../api/content/v1"),
// the builder works against that live TYPO3 host: reads are public, writes
// need the editor supplied preview token from the toolbar. When it is not
// set, the builder uses this app's same-origin demo API, as before.
const builderConfig = {
  apiBase: typo3HostFromContentApiUrl(process.env.TYPO3_CONTENT_API_URL ?? ''),
};
---
<BaseLayout title="Visual builder: AstroTYPO3" description="GrapesJS visual builder for AstroTYPO3, connected to TYPO3 through the content API.">
  <style>
    /* Builder page layout, matching the official free core
       webpage-preset demo (grapesjs.com/demo.html): ONE top bar only,
       then the editor filling the rest of the viewport (100dvh, no
       page level scroll). There is no separate product strip any more:
       the product controls live inside the single top bar row, in the
       .panel__product slot between the device buttons and the basic
       actions. All editor chrome is rendered by the GrapesJS Panels
       module into the mount points below, using the default GrapesJS
       dark theme (its --gjs-* variables: main #444, font #ddd). The
       TYPO3 token lives in a popover toggled from the bar, not in the
       always-visible layout. Left column: Layers. Right column:
       Blocks by default, Styles and Traits as switchable views. */
    .builder-shell { display: flex; flex-direction: column; height: 100dvh; background: var(--gjs-main-color, #444); }
    /* Product controls inside the single top bar. Plain HTML, not a
       GrapesJS panel: these are our TYPO3 page controls, and they keep
       their ids so every existing handler keeps working. At narrow
       widths (1100px and below) this slot wraps onto the bar's second
       line; it is never a second permanent bar. */
    .panel__product { display: flex; align-items: center; gap: 0.5rem; padding: 0 0.35rem; color: #eee; white-space: nowrap; min-width: 0; }
    .app-brand { font-weight: 800; letter-spacing: 0.02em; flex: 0 0 auto; font-size: 0.92rem; }
    .app-brand span { color: var(--gjs-color-highlight, #71b7f1); font-weight: 600; }
    .panel__product label { font-size: 0.8rem; font-weight: 600; flex: 0 0 auto; }
    .panel__product input[type="text"], .panel__product input[type="password"] { background: #2b2b2b; border: 1px solid #555; border-radius: 3px; color: #eee; padding: 0.26rem 0.4rem; font-size: 0.85rem; box-sizing: border-box; }
    #page-title { width: 7rem; }
    #page-slug { width: 4.5rem; }
    .panel__product button { background: rgba(255,255,255,0.08); border: 1px solid #555; border-radius: 3px; color: #eee; padding: 0.26rem 0.55rem; cursor: pointer; font-size: 0.82rem; flex: 0 0 auto; }
    .panel__product button:hover { background: rgba(255,255,255,0.16); }
    #unsaved { color: #f0b429; font-size: 0.85rem; font-weight: 600; flex: 0 0 auto; }
    .status { flex: 0 1 16rem; min-width: 5rem; margin: 0 0 0 auto; font-size: 0.83rem; color: #f3e2c7; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-align: right; }
    /* The token popover is anchored to its toggle button: the wrapper
       is the positioned ancestor, so the popover opens directly under
       the button, aligned to its right edge. */
    .token-anchor { position: relative; flex: 0 0 auto; display: flex; }
    .token-popover { position: absolute; top: calc(100% + 6px); right: 0; width: min(30rem, 94vw); background: #2b2b2b; border: 1px solid #555; border-radius: 6px; padding: 0.75rem 0.85rem; z-index: 60; box-shadow: 0 10px 30px rgba(0,0,0,0.45); white-space: normal; display: flex; flex-direction: column; gap: 0.45rem; }
    .token-popover[hidden] { display: none; }
    .token-popover input[type="password"] { width: 100%; }
    #api-target { font-size: 0.83rem; color: #bbb; }
    .token-note { font-size: 0.78rem; color: #999; }
    .editor-area { display: flex; flex-direction: column; flex: 1; min-height: 0; }
    @media (max-width: 1100px) {
      .panel__top { flex-wrap: wrap; }
      .panel__product { flex-wrap: wrap; row-gap: 0.3rem; }
    }
    /* The top panel bar layout rules live in the is:global block below,
       NOT here: GrapesJS's own stylesheet positions every panel
       absolutely, and the fix has to win over that rule for the
       JS-classed mount points (see the global block for the full
       diagnosis). */
    .editor-main { display: flex; flex: 1; min-height: 0; }
    /* Left column (Layers): the layer tree gets its OWN scroll area
       (flex 1) so it always starts at its true top; the extra sections
       below are fixed siblings and can no longer push or offset the
       list inside one shared scrolled container. Right column (Blocks
       by default, Styles/Traits switchable): the column itself scrolls,
       like the demo's right panel. */
    .panel__left { width: 230px; flex: 0 0 230px; display: flex; flex-direction: column; overflow: hidden; background: var(--gjs-main-color, #444); color: var(--gjs-font-color, #ddd); border-right: 1px solid rgba(0,0,0,0.35); }
    #layers { flex: 1 1 auto; min-height: 0; overflow-y: auto; overflow-x: hidden; padding-top: 0.45rem; }
    .panel__right { width: 260px; flex: 0 0 260px; overflow-y: auto; overflow-x: hidden; background: var(--gjs-main-color, #444); color: var(--gjs-font-color, #ddd); border-left: 1px solid rgba(0,0,0,0.35); }
    #blocks { padding-top: 0.45rem; }
    .editor-view[hidden] { display: none; }
    /* Canvas surround: the demo shows the white page centred on a
       light grey surround. The canvas frame itself is GrapesJS chrome
       (its background is a dark translucent layer); the shell behind
       it is light grey so the page reads as a page on a desk. */
    #gjs { flex: 1; min-width: 0; background: #e6e6e6; }
    .selected-info { font-size: 0.8rem; background: rgba(0,0,0,0.22); border-bottom: 1px solid rgba(255,255,255,0.12); padding: 0.55rem 0.65rem; white-space: pre-wrap; }
    .view-note { font-size: 0.78rem; color: #aaa; padding: 0.5rem 0.65rem; margin: 0; }
    /* Extra tools (new element type form, AI panel) live below Layers
       in the left column as collapsible sections, so the Blocks view
       keeps the official icon tile look and the extras stay one click
       away. */
    .builder-extra { flex: 0 0 auto; border-top: 1px solid rgba(255,255,255,0.14); padding: 0 0.7rem 0.8rem; }
    .builder-extra summary { cursor: pointer; font-weight: 700; font-size: 0.92rem; padding: 0.65rem 0 0.2rem; }
    .builder-extra p { font-size: 0.83rem; color: #bbb; }
    .builder-extra label { display: block; font-weight: 600; margin-top: 0.55rem; font-size: 0.85rem; }
    .builder-extra input[type="text"], .builder-extra textarea, .builder-extra select { width: 100%; padding: 0.38rem; box-sizing: border-box; background: rgba(0,0,0,0.25); border: 1px solid rgba(255,255,255,0.22); border-radius: 3px; color: #eee; margin-top: 0.2rem; }
    .builder-extra button { background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.25); border-radius: 3px; color: #eee; padding: 0.34rem 0.65rem; cursor: pointer; margin-top: 0.55rem; font-size: 0.86rem; }
    .builder-extra button:hover { background: rgba(255,255,255,0.16); }
    .net-field-row { border: 1px solid rgba(255,255,255,0.18); border-radius: 5px; padding: 0.5rem; margin-top: 0.5rem; }
    .net-field-row .row { display: flex; gap: 0.4rem; }
    .net-field-row .row > * { flex: 1; min-width: 0; }
    .net-field-row label { margin-top: 0.35rem; font-weight: 500; }
  </style>
  <style is:global>
    /* Overrides for JS-created GrapesJS DOM. Trait rows, style manager
       fields and block categories are created by GrapesJS at runtime and
       carry no Astro scoped style attributes, so scoped rules never
       reach them (same class of bug as the original inspector fix).
       GrapesJS 0.23.8 trait markup: .gjs-trt-trait is a flex row,
       .gjs-label-wrp is width 30% and .gjs-label has ellipsis overflow,
       which truncated labels ("Subhead..") and squeezed the fields
       against the panel edge. Stack label above field instead: labels
       wrap in full, fields take the full panel width inside the row
       padding, nothing overflows horizontally. */
    .gjs-trt-trait { flex-wrap: wrap; row-gap: 4px; }
    .gjs-trt-trait .gjs-label-wrp { width: 100%; min-width: 0; flex: 1 1 100%; }
    .gjs-trt-trait .gjs-label { white-space: normal; overflow: visible; text-overflow: clip; word-break: break-word; }
    .gjs-trt-trait .gjs-field-wrp { width: 100%; min-width: 0; flex: 1 1 100%; box-sizing: border-box; }
    .gjs-trt-trait .gjs-field { max-width: 100%; box-sizing: border-box; }
    .gjs-trt-trait .gjs-field input, .gjs-trt-trait .gjs-field textarea, .gjs-trt-trait .gjs-field select { width: 100%; max-width: 100%; box-sizing: border-box; }
    .panel__right .gjs-sm-sector .gjs-field, .panel__right .gjs-sm-sector .gjs-field input, .panel__right .gjs-sm-sector .gjs-field select { max-width: 100%; box-sizing: border-box; }
    #traits-box, #styles-box, #layers { overflow-x: hidden; }
    /* Block categories: no top offset, the first category header sits
       at the true top of the blocks scroll region. */
    .gjs-block-categories { margin-top: 0; padding-top: 0; }
    .gjs-block-category:first-child .gjs-title { margin-top: 0; }
    /* Dark scrollbar for the scroll regions. Outside
       .gjs-editor-cont the browser default (light) scrollbar track
       shows as a pale sliver against the dark panel, most visible at
       the top of the column where the track starts. */
    #layers, .panel__right { scrollbar-width: thin; scrollbar-color: rgba(255,255,255,0.28) rgba(0,0,0,0.3); }
    #layers::-webkit-scrollbar, .panel__right::-webkit-scrollbar { width: 8px; }
    #layers::-webkit-scrollbar-track, .panel__right::-webkit-scrollbar-track { background: rgba(0,0,0,0.3); }
    #layers::-webkit-scrollbar-thumb, .panel__right::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.28); border-radius: 4px; }
    /* Block tiles: the demo's tiles are dark boxes with a faint light
       border and a white icon above the label (core tiles are 45%
       wide, 90px min height, 3px radius, 2 per row). Give them a faint
       fill so they read as tiles against the #444 panel. */
    .panel__right .gjs-block { background: rgba(255,255,255,0.05); border-color: rgba(255,255,255,0.10); }
    /* TOP PANEL BAR: the actual ordering mechanism, diagnosed in round
       3 against the installed grapesjs 0.23.8 stylesheet and measured
       in jsdom with the real CSS. GrapesJS ships
         .gjs-pn-panel { display: inline-block; position: absolute; z-index: 3; ... }
       and PanelView adds the gjs-pn-panel class to ALL FOUR mount
       points: .panel__top itself and the three sub-panel mounts.
       Absolutely positioned, the mounts are out of flow, so the flex
       order and margin-left auto set in rounds 1 and 2 never applied
       to layout: the bar's own height collapsed (its children are all
       out of flow), the three mounts stacked at the same static
       position painting in DOM order (devices first, basic actions,
       switcher last and on top, which is why the switcher appeared at
       the left and the devices were buried), and the floating bar
       overlaid the first ~41px of the editor area below it, which is
       what hid the first Blocks category title ("layout") under the
       bar while its tiles showed below the bar's edge.
       Fix: force the mounts back into normal flow with position
       static (specificity 0-2-0/0-3-0 beats the theme's 0-1-0
       .gjs-pn-panel), then the flex row works as intended. Demo
       arrangement: devices left (order 1), product controls next
       (order 2, plain HTML slot, not a panel), basic actions next
       (order 3), switcher at the right end (order 4 + margin-left
       auto). The bar keeps its real height in flow, so nothing below
       it is overlaid any more. */
    .builder-shell .panel__top { position: static; display: flex; align-items: center; background: var(--gjs-main-color, #444); min-height: 41px; }
    .builder-shell .panel__top > .panel__devices { position: static; order: 1; display: flex; align-items: center; }
    .builder-shell .panel__top > .panel__product { order: 2; display: flex; align-items: center; min-width: 0; }
    .builder-shell .panel__top > .panel__basic-actions { position: static; order: 3; display: flex; align-items: center; }
    .builder-shell .panel__top > .panel__switcher { position: static; order: 4; display: flex; align-items: center; margin-left: auto; }
  </style>

  <div class="builder-shell">
    <div class="editor-area">
      <div class="panel__top">
        <div class="panel__devices"></div>
        <div class="panel__product">
          <span class="app-brand">AstroTYPO3 <span>Builder</span></span>
          <label for="page-title">Title</label>
          <input id="page-title" type="text" />
          <label for="page-slug">Slug</label>
          <input id="page-slug" type="text" />
          <button id="btn-load" type="button">Load page</button>
          <button id="btn-local-draft" type="button">Load local draft</button>
          <button id="btn-reset" type="button" title="Reset to fixture home">Reset</button>
          <span class="token-anchor">
            <button id="btn-token" type="button" aria-haspopup="true" aria-expanded="false">TYPO3 token</button>
            <div id="token-popover" class="token-popover" hidden>
              <label for="typo3-token">TYPO3 token</label>
              <input id="typo3-token" type="password" autocomplete="off" placeholder="Preview token (only needed to save to TYPO3)" />
              <span id="api-target"></span>
              <span class="token-note">Tokens are minted from the TYPO3 preview secret (ASTRO_BUILDER_PREVIEW_SECRET) and are scoped: a token minted for a page slug authorizes saving that page, a token minted for the element-types scope authorizes creating element types. The token is kept in page memory only, never stored. Builder UI: GrapesJS (BSD-3-Clause). TYPO3 is the backend through the API only, there is no builder interface inside TYPO3 BE. Each block is a TYPO3 core content element type (CType) and each trait is a tt_content field.</span>
            </div>
          </span>
          <p id="status" class="status" aria-live="polite" title="">Builder starting.</p>
          <span id="unsaved" aria-live="polite"></span>
        </div>
        <div class="panel__basic-actions"></div>
        <div class="panel__switcher"></div>
      </div>
      <div class="editor-main">
        <aside id="panel-left" class="panel__left" aria-label="Layers and tools">
          <div id="layers"></div>

          <details class="builder-extra" id="extra-net">
            <summary>New element type</summary>
            <p>Creating a type here registers it through <code>POST /api/v1/element-types</code>. In production TYPO3 creates the matching core element (CType) and the block appears below without a reload.</p>
            <label for="net-id">Type id (dotted)</label>
            <input id="net-id" type="text" placeholder="custom.pricing-table" />
            <label for="net-label">Label</label>
            <input id="net-label" type="text" placeholder="Pricing Table" />
            <label for="net-category">Category</label>
            <input id="net-category" type="text" placeholder="custom" />
            <div id="net-fields"></div>
            <button id="net-add-field" type="button">Add field</button>
            <button id="net-create" type="button">Create element type</button>
            <p id="net-result" aria-live="polite"></p>
          </details>

          <details class="builder-extra" id="extra-ai">
            <summary>AI assistant (mock)</summary>
            <label for="ai-prompt">Describe a section or page</label>
            <textarea id="ai-prompt" rows="3" placeholder="For example: add an faq section"></textarea>
            <button id="btn-ai" type="button">Generate with mock AI</button>
            <div id="ai-result" style="margin-top: 0.5rem;"></div>
          </details>
        </aside>

        <main id="gjs" aria-label="Canvas"></main>

        <aside class="panel__right" aria-label="Editor views">
          <div id="view-blocks" class="editor-view">
            <div id="blocks"></div>
          </div>
          <div id="view-styles" class="editor-view" hidden>
            <div id="styles-box"></div>
            <p class="view-note">Style manager edits canvas presentation only in this demo. It is not part of the TYPO3 content contract; published styling comes from the design tokens and the Astro renderers.</p>
          </div>
          <div id="view-traits" class="editor-view" hidden>
            <div id="selected-info" class="selected-info">No element selected. Select a block on the canvas to edit its traits (tt_content fields).</div>
            <div id="traits-box"></div>
          </div>
        </aside>
      </div>
    </div>
  </div>

  <script type="application/json" id="builder-data" set:html={JSON.stringify({ registry, home })}></script>
  <script is:inline set:html={`window.__ASTRO_BUILDER_CONFIG__ = ${JSON.stringify(builderConfig)};`}></script>

  <script>
    import grapesjs from 'grapesjs';
    import 'grapesjs/dist/css/grapes.min.css';
    import { CANVAS_CSS_PATH } from '../lib/canvasCss.mjs';
    import { buildGrapesTypes, buildGrapesBlocks, renderElementHtml, propsToAttributes, attributesToProps, defaultsForProps } from '../lib/grapesRegistry.mjs';
    import { registryToElementTypes, mergeElementTypes, elementTypeToRegistryComponent, ctypeFor, ALLOWED_FIELD_TYPES } from '../lib/elementTypes.mjs';
    import { createTypo3ApiClient, registerGrapesStorage, GRAPES_STORAGE_TYPE_ID, pageToGrapesComponents, grapesComponentsToPage, elementToComponentData, DRAFT_LOCALSTORAGE_KEY, getTypo3ApiBase } from '../lib/typo3Storage.mjs';
    import { buildPanelsConfig, registerBuilderCommands } from '../lib/builderPanels.mjs';
    import { createDirtyTracker } from '../lib/dirtyTracking.mjs';
    import { validatePage, validateChangePlan } from '../lib/validate.mjs';
    import { auditPage } from '../lib/audit.mjs';

    const bundled = JSON.parse(document.getElementById('builder-data').textContent);
    // API base resolves from window.__ASTRO_BUILDER_CONFIG__ (server side
    // rendered from TYPO3_CONTENT_API_URL). Empty means the demo API.
    // The token comes from the header strip password input and is read
    // fresh on every write; it is never persisted anywhere.
    const client = createTypo3ApiClient({
      getToken: () => (document.getElementById('typo3-token') || {}).value || '',
    });
    const apiTargetEl = document.getElementById('api-target');
    if (apiTargetEl) {
      apiTargetEl.textContent = client.base
        ? 'Connected to TYPO3 API: ' + client.base + ' (reads are public, saves and new element types need the token)'
        : 'Demo API mode: this app serves the API contract locally.';
    }
    // GrapesJS canvas.styles entries are stylesheet URLs loaded as <link>
    // tags in the canvas iframe, not CSS text. The canvas stylesheet is
    // served by this app at a stable path, composed from the same
    // tokens.css and global.css sources as the public site
    // (src/pages/builder-canvas.css.ts). An absolute URL is used so the
    // canvas iframe resolves it against this origin reliably.
    const canvasCssUrl = new URL(CANVAS_CSS_PATH, window.location.origin).href;

    // Live registry state: bundled core components plus API-created types.
    const registryState = { contractVersion: bundled.registry.contractVersion || '1.0.0', components: [...bundled.registry.components] };
    const registryById = () => new Map(registryState.components.map((c) => [c.id, c]));

    const pageMeta = { id: 'page-builder', slug: 'home', title: 'Home', locale: 'en', seo: {} };
    const storageState = {
      page: null,
      meta: pageMeta,
      registry: registryState,
      getComponents: () => { const list = []; if (editor) editor.getWrapper().components().forEach((c) => list.push(c)); return list; },
    };

    let editor = null;
    let uid = 1000;
    // Status line: the visible text stays short enough to read in the
    // top bar (the bar ellipsises overflow, which cut the old ready
    // text mid-URL); the full detail goes to the title attribute.
    const setStatus = (msg, detail) => { const el = document.getElementById('status'); el.textContent = msg; el.title = detail || msg; };
    const clone = (x) => JSON.parse(JSON.stringify(x));
    function nextElementId(componentId) { uid += 1; return 'el-' + componentId.replace(/[^a-z0-9]+/gi, '-') + '-' + uid; }

    function tagFor(def) {
      if (def.id === 'navigation.header') return 'header';
      if (def.id === 'navigation.footer') return 'footer';
      if (def.id.startsWith('section.')) return 'section';
      if (def.id === 'content.heading') return 'h2';
      if (def.id === 'content.image') return 'figure';
      if (def.id === 'content.divider') return 'hr';
      return 'div';
    }

    function containerStyle(def, props) {
      if (def.id === 'layout.container') {
        const pad = props.padding === 'lg' ? '2.5rem' : props.padding === 'sm' ? '0.75rem' : '1.25rem';
        const style = { 'max-width': 'var(--container)', margin: '0 auto', padding: pad + ' 1.25rem' };
        if (props.background && props.background !== 'transparent') style.background = props.background;
        return style;
      }
      if (def.id === 'layout.columns') return { display: 'grid', gap: '1.25rem', 'grid-template-columns': 'repeat(auto-fit, minmax(220px, 1fr))' };
      return {};
    }

    // Register one registry component as a GrapesJS component type + block.
    function registerComponentType(def) {
      const typeDesc = buildGrapesTypes({ components: [def] })[0];
      if (!editor.DomComponents.getType(def.id)) {
        editor.DomComponents.addType(def.id, {
          model: {
            defaults: {
              tagName: tagFor(def),
              traits: typeDesc.traits,
              attributes: typeDesc.defaults.attributes,
              droppable: def.childrenAllowed ? (dragged) => {
                const draggedId = (dragged && dragged.getAttributes && dragged.getAttributes()['data-astro-component-id']) || (dragged && dragged.get && dragged.get('type'));
                return def.childrenAllowed.includes(draggedId);
              } : false,
            },
            init() {
              if (def.childrenAllowed) {
                try { this.setStyle(containerStyle(def, attributesToProps(def, this.get('attributes') || {}))); } catch {}
              }
            },
            updated(property) {
              if (property !== 'attributes') return;
              if (def.childrenAllowed) {
                try { this.setStyle(containerStyle(def, attributesToProps(def, this.get('attributes') || {}))); } catch {}
              } else if (this.view) {
                try { this.view.render(); } catch {}
              }
            },
          },
          view: def.childrenAllowed ? {} : {
            render() {
              // Leaf components have no GrapesJS children: the canvas shows
              // the same markup the Astro renderer produces for these props.
              this.renderAttributes();
              if (!this.modelOpt.temporary) {
                const attrs = this.model.get('attributes') || {};
                this.el.innerHTML = renderElementHtml(def, attributesToProps(def, attrs), '');
                this.postRender();
              }
              return this;
            },
          },
        });
      }
      const block = buildGrapesBlocks({ components: [def] })[0];
      if (!editor.BlockManager.get(block.id)) {
        editor.BlockManager.add(block.id, { label: block.label, category: block.category, title: block.title, media: block.media, content: block.content });
      }
    }

    function serializePage() {
      const list = [];
      editor.getWrapper().components().forEach((c) => list.push(c));
      return grapesComponentsToPage(list, pageMeta, registryState);
    }

    function applyPage(page) {
      storageState.page = page;
      pageMeta.id = page.id || pageMeta.id;
      pageMeta.slug = page.slug || pageMeta.slug;
      pageMeta.title = page.title || '';
      pageMeta.locale = page.locale || 'en';
      pageMeta.seo = clone(page.seo || {});
      storageState.meta = pageMeta;
      document.getElementById('page-title').value = pageMeta.title;
      document.getElementById('page-slug').value = pageMeta.slug;
      editor.setComponents(pageToGrapesComponents(page, registryState));
    }

    // Dirty tracking lives in lib/dirtyTracking.mjs. GrapesJS 0.23.8
    // increments its change counter asynchronously (a debounced
    // setTimeout in EditorModel.handleUpdates), so a synchronous
    // clearDirtyCount() after setComponents is overwritten one tick
    // later by the load's own pending increment. The tracker gates the
    // label while initializing and only establishes the clean state
    // after the counter has settled (see the module header).
    let dirtyTracker = null;
    function showUnsaved(count) {
      document.getElementById('unsaved').textContent = count > 0 ? 'Unsaved changes' : '';
    }
    function markDirty() {
      if (dirtyTracker) dirtyTracker.refresh();
    }
    function markClean() {
      if (dirtyTracker) dirtyTracker.markClean();
      else document.getElementById('unsaved').textContent = '';
    }

    // Page actions, invoked from the GrapesJS top panel buttons through
    // the commands registered in lib/builderPanels.mjs.
    async function saveDraft() {
      const page = serializePage();
      const check = validatePage(page, registryState);
      if (!check.valid) { setStatus('Cannot save, validation failed:\n' + check.errors.join('\n')); return; }
      localStorage.setItem(DRAFT_LOCALSTORAGE_KEY, JSON.stringify(page));
      storageState.page = page;
      try {
        const out = await editor.store();
        // A debounced increment from the last edit can still be
        // pending at store time; settle, then reset.
        await dirtyTracker.settleAndMarkClean();
        setStatus('Saved draft through the typo3-api storage adapter. ' + ((out && out.notice) || ''));
      } catch (err) {
        setStatus('Saved to the local backup only. API save failed: ' + String(err && err.message ? err.message : err));
      }
    }

    function validateCurrent() {
      const page = serializePage();
      const check = validatePage(page, registryState);
      const findings = auditPage(page);
      setStatus(check.valid
        ? 'Validation passed. Audit findings: ' + findings.length + (findings.length ? ' (' + findings.map((f) => f.code).join(', ') + ')' : '')
        : 'Validation failed:\n' + check.errors.join('\n'));
    }

    async function publishNow() {
      try {
        const res = await fetch('/api/publish', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ slug: pageMeta.slug }) });
        const out = await res.json();
        setStatus('Publish result (' + res.status + '): ' + (out.message || JSON.stringify(out)));
      } catch (err) { setStatus('Publish failed: ' + String(err)); }
    }

    const panelHandlers = {
      onSave: () => { void saveDraft(); },
      onValidate: () => validateCurrent(),
      onPublish: () => { void publishNow(); },
    };

    function initEditor() {
      editor = grapesjs.init({
        container: '#gjs',
        height: '100%',
        fromElement: false,
        noticeOnUnload: false,
        storageManager: { type: GRAPES_STORAGE_TYPE_ID, autosave: false, autoload: false, stepsBeforeSave: 1 },
        deviceManager: {
          devices: [
            { name: 'Desktop', width: '' },
            { name: 'Tablet', width: '768px', widthMedia: '992px' },
            { name: 'Mobile', width: '390px', widthMedia: '575px' },
          ],
        },
        blockManager: { appendTo: '#blocks' },
        layerManager: { appendTo: '#layers' },
        traitManager: { appendTo: '#traits-box' },
        styleManager: {
          appendTo: '#styles-box',
          sectors: [
            { name: 'Dimension', open: false, properties: ['width', 'min-height', 'padding', 'margin'] },
            { name: 'Typography', open: false, properties: ['font-size', 'font-weight', 'letter-spacing', 'color', 'line-height', 'text-align'] },
            { name: 'Decorations', open: false, properties: ['background-color', 'border', 'border-radius', 'box-shadow'] },
          ],
        },
        canvas: { styles: [canvasCssUrl] },
        // Editor chrome comes from the Panels module: buildPanelsConfig
        // (lib/builderPanels.mjs) defines the top bar with device
        // buttons, basic actions and the views switcher, rendered into
        // the .panel__top mount points above.
        panels: buildPanelsConfig(),
        plugins: [
          (ed) => {
            // GrapesJS 0.23.8: custom storages register via StorageManager.add,
            // there is no Storage.addType. registerGrapesStorage is the single
            // shared code path, also covered by tests/storage-editor.test.mjs.
            registerGrapesStorage(ed, storageState, client);
          },
          (ed) => { registerBuilderCommands(ed, panelHandlers); },
        ],
      });

      dirtyTracker = createDirtyTracker(editor, showUnsaved);

      for (const def of registryState.components) registerComponentType(def);

      // New components dropped from blocks need a stable element id.
      editor.on('component:add', (comp) => {
        try {
          const attrs = comp.getAttributes() || {};
          const cid = attrs['data-astro-component-id'] || comp.get('type');
          if (cid && !attrs['data-astro-element-id']) {
            comp.addAttributes({ 'data-astro-component-id': cid, 'data-astro-element-id': nextElementId(cid) });
          }
        } catch {}
      });
      editor.on('component:selected', (comp) => {
        const attrs = (comp && comp.getAttributes && comp.getAttributes()) || {};
        const cid = attrs['data-astro-component-id'] || (comp && comp.get && comp.get('type')) || '';
        document.getElementById('selected-info').textContent =
          'Element: ' + (attrs['data-astro-element-id'] || '(no id)') + '\nComponent: ' + cid + '\nTYPO3 CType: ' + (cid ? ctypeFor(cid) : '(none)');
      });
      editor.on('component:deselected', () => {
        document.getElementById('selected-info').textContent = 'No element selected. Select a block on the canvas to edit its traits (tt_content fields).';
      });
      editor.on('update', markDirty);
    }

    async function loadInitialPage() {
      // Template hand-off from /templates keeps working.
      const pending = localStorage.getItem('astrotypo3-apply-template');
      if (pending) {
        localStorage.removeItem('astrotypo3-apply-template');
        try {
          const t = JSON.parse(pending);
          if (t.mode === 'replace') {
            applyPage({ id: 'page-builder', slug: t.slug || 'home', title: t.title || 'Untitled page', status: 'draft', locale: 'en', seo: { title: '', description: '' }, elements: clone(t.elements || []) });
            setStatus('Template applied in replace mode. Review, then Save draft.');
            return;
          }
          const base = (await client.loadPage(t.slug || 'home')) || bundled.home;
          applyPage({ ...clone(base), elements: clone(base.elements || []).concat(clone(t.elements || [])) });
          setStatus('Template sections appended. Review, then Save draft.');
          return;
        } catch {}
      }
      const slug = new URLSearchParams(location.search).get('slug') || 'home';
      let page = null;
      try { page = await client.loadPage(slug); } catch (err) { setStatus('Content API load failed, using bundled fixture. ' + String(err)); }
      applyPage(page || clone(bundled.home));
    }

    function wireToolbar() {
      // TYPO3 token popover: the token input stays in the DOM (the API
      // client reads it fresh on every write) but is only visible when
      // toggled open from the top bar.
      const tokenBtn = document.getElementById('btn-token');
      const tokenPop = document.getElementById('token-popover');
      if (tokenBtn && tokenPop) {
        tokenBtn.addEventListener('click', () => {
          tokenPop.hidden = !tokenPop.hidden;
          tokenBtn.setAttribute('aria-expanded', String(!tokenPop.hidden));
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !tokenPop.hidden) { tokenPop.hidden = true; tokenBtn.setAttribute('aria-expanded', 'false'); }
        });
      }
      document.getElementById('page-title').addEventListener('change', (e) => { pageMeta.title = e.target.value; markDirty(); });
      document.getElementById('page-slug').addEventListener('change', (e) => { pageMeta.slug = e.target.value.trim() || 'home'; });
      document.getElementById('btn-load').addEventListener('click', async () => {
        const slug = document.getElementById('page-slug').value.trim() || 'home';
        try {
          const page = await client.loadPage(slug);
          if (!page) { setStatus('No published page found for slug "' + slug + '" in the content API.'); return; }
          applyPage(page);
          // The load's setComponents schedules debounced counter
          // increments; settle before resetting or the label flips back
          // to "Unsaved changes" one tick later.
          await dirtyTracker.settleAndMarkClean();
          setStatus('Loaded page "' + slug + '" from the content API.');
        } catch (err) { setStatus('Load failed: ' + String(err)); }
      });
      document.getElementById('btn-local-draft').addEventListener('click', () => {
        try {
          const raw = localStorage.getItem(DRAFT_LOCALSTORAGE_KEY);
          if (!raw) { setStatus('No local draft backup found.'); return; }
          applyPage(JSON.parse(raw));
          setStatus('Loaded the local draft backup. It is not saved on the server until you press Save draft.');
        } catch { setStatus('Local draft backup could not be parsed.'); }
      });
      document.getElementById('btn-reset').addEventListener('click', () => {
        if (!confirm('Reset the canvas to the bundled fixture home page? Unsaved changes are lost.')) return;
        applyPage(clone(bundled.home));
        setStatus('Canvas reset to the fixture home page.');
      });
    }

    // ---- New element type form -------------------------------------------
    function addFieldRow() {
      const wrap = document.getElementById('net-fields');
      const row = document.createElement('div');
      row.className = 'net-field-row';
      const nameInput = document.createElement('input');
      nameInput.type = 'text'; nameInput.placeholder = 'field name (camelCase)'; nameInput.setAttribute('data-net', 'name');
      const typeSelect = document.createElement('select');
      typeSelect.setAttribute('data-net', 'type');
      for (const t of ALLOWED_FIELD_TYPES) { const o = document.createElement('option'); o.value = t; o.textContent = t; typeSelect.appendChild(o); }
      const top = document.createElement('div'); top.className = 'row'; top.appendChild(nameInput); top.appendChild(typeSelect);
      const defInput = document.createElement('input');
      defInput.type = 'text'; defInput.placeholder = 'default value (optional)'; defInput.setAttribute('data-net', 'default');
      const valuesInput = document.createElement('input');
      valuesInput.type = 'text'; valuesInput.placeholder = 'enum values, comma separated'; valuesInput.setAttribute('data-net', 'values');
      const reqLabel = document.createElement('label');
      const reqInput = document.createElement('input');
      reqInput.type = 'checkbox'; reqInput.setAttribute('data-net', 'required');
      reqLabel.appendChild(reqInput); reqLabel.appendChild(document.createTextNode(' required'));
      const remove = document.createElement('button');
      remove.type = 'button'; remove.textContent = 'Remove field';
      remove.addEventListener('click', () => row.remove());
      row.appendChild(top); row.appendChild(defInput); row.appendChild(valuesInput); row.appendChild(reqLabel); row.appendChild(remove);
      wrap.appendChild(row);
    }

    function readFieldRows() {
      return [...document.querySelectorAll('#net-fields .net-field-row')].map((row) => {
        const get = (key) => row.querySelector('[data-net="' + key + '"]');
        const field = { name: get('name').value.trim(), type: get('type').value, required: get('required').checked };
        const def = get('default').value;
        if (def !== '') field.default = field.type === 'number' ? Number(def) : field.type === 'boolean' ? def === 'true' : def;
        if (field.type === 'enum') field.values = get('values').value.split(',').map((v) => v.trim()).filter(Boolean);
        return field;
      });
    }

    function wireNewElementTypeForm() {
      addFieldRow();
      document.getElementById('net-add-field').addEventListener('click', addFieldRow);
      document.getElementById('net-create').addEventListener('click', async () => {
        const result = document.getElementById('net-result');
        const payload = {
          id: document.getElementById('net-id').value.trim(),
          label: document.getElementById('net-label').value.trim(),
          category: document.getElementById('net-category').value.trim() || 'custom',
          fields: readFieldRows(),
        };
        try {
          const type = await client.createElementType(payload);
          if (!registryById().has(type.id)) {
            const def = elementTypeToRegistryComponent(type);
            registryState.components.push(def);
            registerComponentType(def);
          }
          result.textContent = 'Created element type ' + type.id + '. TYPO3 CType: ' + type.ctype + '. Its block is now in the Blocks panel.';
          setStatus('Element type ' + type.id + ' registered through the API and added to the builder.');
        } catch (err) {
          const details = err && err.body && err.body.error && err.body.error.details ? '\n' + err.body.error.details.join('\n') : '';
          result.textContent = 'Create failed: ' + String(err && err.message ? err.message : err) + details;
        }
      });
    }

    // ---- AI panel (mock provider, labelled) -------------------------------
    function wireAiPanel() {
      document.getElementById('btn-ai').addEventListener('click', async () => {
        const prompt = document.getElementById('ai-prompt').value.trim();
        const box = document.getElementById('ai-result'); box.innerHTML = '';
        if (!prompt) { setStatus('Write an AI prompt first.'); return; }
        const res = await fetch('/api/ai/generate', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ prompt }) });
        const out = await res.json();
        if (!res.ok || !out.plan) { setStatus('AI mock failed: ' + JSON.stringify(out)); return; }
        const pre = document.createElement('pre'); pre.style.whiteSpace = 'pre-wrap';
        pre.textContent = 'Provider: mock (labelled mock, not a real model)\n' + JSON.stringify(out.plan, null, 2);
        box.appendChild(pre);
        const apply = document.createElement('button'); apply.type = 'button'; apply.textContent = 'Review done: apply plan';
        apply.addEventListener('click', () => {
          const check = validateChangePlan(out.plan, registryState);
          if (!check.valid) { setStatus('Plan rejected by validation:\n' + check.errors.join('\n')); return; }
          for (const op of out.plan.operations) {
            if (op.type === 'add_element' && op.element) {
              editor.getWrapper().append(pageToGrapesComponents({ elements: [clone(op.element)] }, registryState));
            }
          }
          markDirty();
          setStatus('Applied mock AI plan. Review the new elements before saving.');
        });
        box.appendChild(apply);
      });
    }

    // ---- Bootstrap ----------------------------------------------------------
    (async () => {
      try {
        // Element types from the API win over the bundled registry copy.
        try {
          const apiTypes = await client.loadElementTypes();
          if (Array.isArray(apiTypes) && apiTypes.length) {
            const known = registryById();
            for (const t of apiTypes) {
              if (!known.has(t.id)) registryState.components.push(elementTypeToRegistryComponent(t));
            }
          }
        } catch { /* demo fallback: bundled registry only */ }
        initEditor();
        // The layers scroll region starts at its true top.
        const layersRegion = document.getElementById('layers');
        if (layersRegion) layersRegion.scrollTop = 0;
        const blocksRegion = document.getElementById('blocks');
        if (blocksRegion) blocksRegion.scrollTop = 0;
        wireToolbar();
        wireNewElementTypeForm();
        wireAiPanel();
        await loadInitialPage();
        // True end of initialization: every async step above has
        // resolved and the final setComponents is in the canvas. Only
        // now establish the clean state, after the GrapesJS change
        // counter (debounced, async) has settled. A plain markClean()
        // here was overwritten one tick later by the load's pending
        // increment, which is why "Unsaved changes" showed on load.
        await dirtyTracker.finishInitialization();
        setStatus(
          client.base ? 'Builder ready. Storage: live TYPO3.' : 'Builder ready. Storage: demo API.',
          client.base
            ? 'Builder ready. Blocks are TYPO3 core element types, traits are their fields. Storage target: live TYPO3 at ' + client.base + '. Enter a preview token in the toolbar before saving.'
            : 'Builder ready. Blocks are TYPO3 core element types, traits are their fields. Demo API storage: saves go to the demo endpoint in this app.',
        );
      } catch (err) {
        setStatus('Builder failed to start: ' + String(err && err.message ? err.message : err));
      }
    })();
  </script>
</BaseLayout>
