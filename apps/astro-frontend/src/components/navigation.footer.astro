---
const { element, preview = false } = Astro.props;
const p = element?.props ?? {};
const attrs = preview ? { 'data-astro-builder-id': element.id, class: 'preview-editable' } : {};
---

<footer {...attrs} class="site-footer"><div class="container">
  <p>{p.text ?? ''}</p>
  <nav aria-label="Footer"><ul>{(p.links ?? []).map((link: any) => <li><a href={link.href}>{link.label}</a></li>)}</ul></nav>
</div></footer>
