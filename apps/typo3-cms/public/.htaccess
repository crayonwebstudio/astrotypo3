# TYPO3 frontend rewrites (condensed standard rules for Apache mod_rewrite).
RewriteEngine On

# Existing files, directories and symlinks are served directly.
# The bare /typo3 redirect to /typo3/ is handled at server level
# (typo3-redirect.conf written by the Dockerfile): a per-directory
# redirect rule here produced a Location with the filesystem path.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d [OR]
RewriteCond %{REQUEST_FILENAME} -l
RewriteRule .* - [L]

# Everything else goes to the frontend controller.
RewriteRule .* index.php [L]
